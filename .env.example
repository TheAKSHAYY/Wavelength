# Copy this file to .env and fill in real values.
# NEVER commit a real API key or secret to this repo (or anywhere).

# --- OpenAI (required for AI panels) ---
# Get your key from https://platform.openai.com/api-keys
# NOTE: This is separate from a ChatGPT Plus/Go subscription -- it needs its
# own pay-as-you-go billing set up at platform.openai.com/settings/billing.
OPENAI_API_KEY=sk-your-key-here

# Optional: cheaper/faster (default) vs higher quality
# gpt-4o-mini = cheap, good enough for most panels
# gpt-4o      = higher quality, costs more
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
# Port for the backend proxy server (frontend expects 3001 by default, see vite.config.ts)
PORT=3001

# Comma-separated list of origins allowed to call the backend.
# In dev the frontend runs on this origin; tighten this for production.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login sessions. REQUIRED in production -- set to a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me

# Optional shared secret for the /api/generate endpoint (headless / curl use).
# If set, requests must include it via the x-api-key header
# (or "Authorization: Bearer <token>"). Leave blank for plain local dev.
API_TOKEN=

# Path to the SQLite database file.
DB_PATH=./data/wavelength.db

# Set to "true" when serving over HTTPS (browser will only send the session
# cookie over secure connections).
COOKIE_SECURE=false

# --- Optional: real YouTube analytics ---
# Public-data API key (https://console.cloud.google.com/apis/credentials).
# Without these, the Analytics page shows sample data.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
