# ========================================================
# WAVELENGTH ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and fill in whichever keys you have.
# If no keys are provided, Wavelength runs with built-in
# real YouTube research synthesis and local AI generator.

# --------------------------------------------------------
# 1. FREE OPTION A: Google Gemini (Recommended - Free Tier)
# --------------------------------------------------------
# Free tier: 15 requests/min, 1,500 requests/day, 1M context window
# Get your free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------------------
# 2. FREE OPTION B: Groq Cloud (Ultra-Fast 500+ tok/s)
# --------------------------------------------------------
# Free tier: Ultra-low latency Llama 3.3 70B & DeepSeek R1
# Get your free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------------
# 3. FREE OPTION C: OpenRouter Free Endpoints
# --------------------------------------------------------
# Free tier: Access open-source models with :free tag
# Get your key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --------------------------------------------------------
# 4. OPTION D: Local Ollama / Custom Base URL (100% Free)
# --------------------------------------------------------
# Run offline with Ollama: ollama run llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# --------------------------------------------------------
# 5. OPTION E: OpenAI (Standard)
# --------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --------------------------------------------------------
# Server Configuration
# --------------------------------------------------------
PORT=4180
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=dev-only-secret-change-me
API_TOKEN=
DB_PATH=./data/wavelength.db
COOKIE_SECURE=false

# --------------------------------------------------------
# Optional: YouTube Data API v3
# --------------------------------------------------------
# For private channel stats & uploads.
# Note: Real-time search autocomplete uses the built-in free
# YouTube Suggest API (zero quota consumed).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

